<?xml version="1.0"?>
<ruleset name="AllTerrain Forms">
	<description>WordPress Coding Standards for the AllTerrain Forms plugin.</description>

	<file>.</file>

	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/tests/vitest/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!--
	Errors fail the build; warnings are printed and read but do not.

	Every warning left in this tree has been looked at and is deliberate. They
	fall into two groups. `uninstall.php` runs direct `$wpdb` queries because it
	is bulk-deleting a site's form data in one pass — every one is prepared, and
	object caching is meaningless for rows that are about to stop existing. The
	rest are in tests: `var_export()` builds the failure message a developer
	reads when an assertion fails, which is exactly what it is for.

	Suppressing each one individually would put a `phpcs:ignore` beside a hundred
	lines that are already correct, and a file dense with ignores is a file where
	nobody notices a new one.
	-->
	<config name="ignore_warnings_on_exit" value="1"/>

	<rule ref="WordPress"/>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="allterrain-forms"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="alltfo_"/>
				<element value="ALLTFO_"/>
				<element value="allterrain_forms"/>
			</property>
		</properties>
	</rule>
</ruleset>
